# Copy to .env (docker compose reads it). Never commit real secrets.
POSTGRES_PASSWORD=change-me
ERAG_EMBEDDER=bge-small            # hashing | bge-small | bge-m3
ERAG_RERANKER=cross-encoder        # none | lexical | cross-encoder
ERAG_LLM_MODEL=qwen2.5:3b-instruct # pulled into the ollama container (see README)
ERAG_SEED_DEMO=1                   # 1 = create demo users on start and print their tokens; 0 in production
